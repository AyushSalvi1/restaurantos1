# Copy to .env and adjust. Never commit the filled-in file.

# ---------------------------------------------------------------------------------------------
# Required in every non-local environment. The prod profile refuses to boot on the default value.
# Generate with: openssl rand -base64 48
# ---------------------------------------------------------------------------------------------
JWT_SECRET=
JWT_ISSUER=lifeos

# ---------------------------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------------------------
MYSQL_DATABASE=lifeos
MYSQL_USER=lifeos
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_PORT=3306

# ---------------------------------------------------------------------------------------------
# Ports
# ---------------------------------------------------------------------------------------------
BACKEND_PORT=8080
FRONTEND_PORT=8081
REDIS_PORT=6379
MAILPIT_UI_PORT=8025
OLLAMA_PORT=11434

# ---------------------------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------------------------
APP_BASE_URL=http://localhost:8081
CORS_ALLOWED_ORIGINS=http://localhost:8081
SCHEDULER_ENABLED=true

# Demo seeding is for local exploration only. Never enable it against real data.
SEED_DATA_ENABLED=false
DEMO_MODE=false

# ---------------------------------------------------------------------------------------------
# AI providers. With AI_PROVIDER=heuristic no key is needed and the app runs fully offline using
# deterministic local tokenisation, embeddings and template-based replies.
# ---------------------------------------------------------------------------------------------
AI_PROVIDER=heuristic
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------------------------------------
# Mail. The compose `mail` profile starts Mailpit on this port for local password-reset links.
# ---------------------------------------------------------------------------------------------
MAIL_HOST=localhost
MAIL_PORT=1025
